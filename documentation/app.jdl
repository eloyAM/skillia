entity Person {
  username String required unique,
  fullName String,
  email String,
  title String,
  department String
}

entity Skill {
  id Long required unique,
  name String required unique,
  description String
}

entity SkillTag {
  id Long required unique,
  name String required unique
}

entity PersonSkill {
  id Long required unique,
  level Integer required min(1) max(5),
  lastModifiedDate Instant
}

entity SkillGroup {
  id Long required unique,
  name String required unique,
  description String
}

entity Department {
  id Long required unique,
  name String required unique
}

relationship OneToMany {
  Person{personSkills} to PersonSkill
}

relationship ManyToOne {
  PersonSkill{skill} to Skill
  PersonSkill{person} to Person
}

relationship ManyToMany {
  Skill{tags} to SkillTag
}

relationship ManyToMany {
  SkillGroup{skills} to Skill
}

relationship ManyToMany {
  Department{skillGroups} to SkillGroup
}

relationship OneToMany {
  Department{people} to Person
}