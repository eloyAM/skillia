entity Person {
  username String required unique,
  fullName String,
  email String,
  title String,
  department String
}

entity Skill {
  id Long required unique,
  name String required unique
}

entity SkillTag {
  id Long required unique,
  name String required unique
}

entity PersonSkill {
  id Long required unique,
  level Integer required min(1) max(5)
}

entity SkillGroup {
  id Long required unique,
  name String required unique
  description String
}

entity Department {
  id Long required unique,
  name String required unique
}

relationship OneToMany {
  Person to PersonSkill {personSkills required}
}

relationship OneToMany {
  Skill to PersonSkill {personSkills required}
}

relationship ManyToMany {
  Skill to SkillTag {tags required}
}

relationship ManyToMany {
  SkillGroup to Skill {skills required}
}

relationship ManyToMany {
  Department to SkillGroup {skillGroups required}
}

relationship OneToMany {
  Department to Person {people}
}